{
  "name": "IDEA Light",
  "appearance": "light",
  "style": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#20242B",
    "editor.active_line.background": "#F5F8FE",
    "editor.line_number": "#AEB3C2",
    "editor.active_line_number": "#767A8A",
    "editor.gutter.background": "#FFFFFF",
    "syntax": {
      "keyword": { "color": "#0033B3" },
      "string": { "color": "#067D17" },
      "string.escape": { "color": "#0037A6" },
      "string.special": { "color": "#264EFF" },
      "embedded": { "color": "#20242B" },
      "punctuation.special": { "color": "#0033B3" },
      "comment": { "color": "#8C8C8C", "font_style": "italic" },
      "comment_doc": { "color": "#8C8C8C", "font_style": "italic" },
      "number": { "color": "#1750EB" },
      "boolean": { "color": "#0033B3" },
      "function": { "color": "#00627A" },
      "preproc": { "color": "#00627A" },
      "type": { "color": "#20242B" },
      "constructor": { "color": "#20242B" },
      "property": { "color": "#871094" },
      "constant": { "color": "#871094" },
      "attribute": { "color": "#9E880D" },
      "tag": { "color": "#0033B3" },
      "tag.doctype": { "color": "#8C8C8C" },
      "title": { "color": "#0033B3", "font_weight": 700 },
      "emphasis": { "color": "#20242B", "font_style": "italic" },
      "emphasis.strong": { "color": "#20242B", "font_weight": 700 },
      "link_text": { "color": "#00627A" },
      "link_uri": { "color": "#1750EB" },
      "text.code.span": { "color": "#067D17" },
      "text.literal": { "color": "#067D17" },
      "label": { "color": "#00627A" },
      "variable": { "color": "#20242B" },
      "operator": { "color": "#20242B" },
      "punctuation": { "color": "#20242B" }
    }
  }
}
